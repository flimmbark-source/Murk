{
  "name": "murk",
  "version": "0.1.0",
  "description": "A lane-based board game prototype set in a Victorian orphanage",
  "type": "module",
  "scripts": {
    "dev:cli": "tsx src/index.ts",
    "dev:web": "npm run build && node dist/server/server.js",
    "dev": "concurrently \"npm run build:watch\" \"npm run serve:watch\"",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "start": "node dist/server/server.js",
    "serve:watch": "nodemon --watch dist dist/server/server.js",
    "test": "vitest",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "game",
    "prototype",
    "board-game"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.11",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^1.1.0"
  }
}
